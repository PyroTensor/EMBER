# EMBER Frontend Environment Configuration
# Copy to .env.local to customize locally

# FastAPI backend base URL (used when Mock Mode is OFF)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "true" to default to offline contract mock data + TypeScript physics engine
# (Can also be toggled at runtime via the top navigation bar switch)
NEXT_PUBLIC_USE_MOCK_DATA=false
