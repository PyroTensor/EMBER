# ---------- Database (Postgres + pgvector via docker compose) ----------
DATABASE_URL=postgresql://ember:ember@localhost:5432/ember
# Read-only role used by the RAG sql_tool (created in backend/app/db/schema.sql)
DATABASE_URL_READONLY=postgresql://ember_ro:ember_ro@localhost:5432/ember

# ---------- LLM (provider-agnostic) ----------
# gemini | openai | anthropic | heuristic   (heuristic = offline rule-based fallback, no key needed)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- Embeddings ----------
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

# ---------- Tracing (optional) ----------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ember

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_DATA=false
