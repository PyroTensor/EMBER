# EMBER backend settings. Copy to backend/.env (read from backend/, not the repo root).
# Every key maps 1:1 to a field of app.core.config.Settings. Names are CASE-SENSITIVE (UPPERCASE).
# Required: DB_USER, DB_PASSWORD, DB_NAME. Everything else has a local default.

# ── app ───────────────────────────────────────────────────────────────
# dev | test | prod
ENV=dev
LOG_LEVEL=INFO
# true → JSON log lines (use in prod)
LOG_JSON=false

# ── database (also used by docker-compose.yml) ────────────────────────
# DATABASE_URL / DATABASE_URL_READONLY are built from these (asyncpg driver); don't set them directly.
DB_HOST=localhost
# host port mapped to the container's 5432 (change if 5432 is taken locally)
DB_PORT=5432
DB_USER=ember
DB_PASSWORD=ember
DB_NAME=ember
# read-only role (created by migration 0004), used by GET endpoints and the RAG sql_tool
DB_RO_USER=ember_ro
DB_RO_PASSWORD=ember_ro
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_S=2

# auto (probe → postgres or snapshot) | postgres | snapshot
DATA_BACKEND=auto
# seconds the DB availability decision is cached
DB_PROBE_TTL_S=15
SNAPSHOT_PATH=data/.cache/store.json
SEED_DIR=data/seed

# ── HTTP ──────────────────────────────────────────────────────────────
# JSON list or comma-separated. Never "*". Must be https when ENV=prod.
CORS_ORIGINS=["http://localhost:3000"]

# ── LLM ───────────────────────────────────────────────────────────────
# heuristic | gemini | openai   (heuristic needs no key; tests and eval run with it)
LLM_PROVIDER=heuristic
# model for the selected provider, e.g. gemini-2.5-flash or gpt-4.1-mini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── embeddings ────────────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
# load + run the embedder once at startup to avoid a cold first request
EMBED_WARMUP=true

# ── RAG ───────────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_MAX_REWRITES=2
RAG_ANSWER_EVIDENCE=8

# ── tracing (optional, extra "tracing") ───────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ember
